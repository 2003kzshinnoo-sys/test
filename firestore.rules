rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Schema validation for expense reports (allows open access without domain/OAuth barrier)
    function isValidReport(data) {
      return data.keys().hasAll([
        'title', 'date', 'amount', 'category', 'merchant', 'description',
        'status', 'fileUrl', 'filePath', 'fileName', 'fileType', 'fileSize',
        'userId', 'userEmail', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'date', 'amount', 'category', 'merchant', 'description',
        'status', 'fileUrl', 'filePath', 'fileName', 'fileType', 'fileSize',
        'userId', 'userEmail', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
      data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
      data.merchant is string && data.merchant.size() >= 1 && data.merchant.size() <= 100 &&
      data.description is string && data.description.size() <= 1000 &&
      data.fileUrl is string && data.fileUrl.size() >= 1 &&
      data.filePath is string && data.filePath.size() >= 1 &&
      data.fileName is string && data.fileName.size() >= 1 &&
      data.fileType is string && data.fileType.size() >= 1 &&
      data.fileSize is number && data.fileSize > 0 && data.fileSize <= 5242880 &&
      data.createdAt is string &&
      data.updatedAt is string;
    }

    // Reports collection - Direct access enabled
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId) && isValidReport(incoming());
      allow delete: if isValidId(reportId);
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
