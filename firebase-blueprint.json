{
  "entities": {
    "Report": {
      "title": "Expense Receipt Report",
      "description": "Schema for an expense receipt report including metadata and uploaded attachment info",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Title of the expense report"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Expense date in YYYY-MM-DD format"
        },
        "amount": {
          "type": "number",
          "description": "Total expense amount in JPY"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Expense category (e.g., 交通費, 消耗品費, 接待交際費, 旅費交通費, 通信費, 備品購入, 会議費, その他)"
        },
        "merchant": {
          "type": "string",
          "maxLength": 100,
          "description": "Payee or merchant name"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Details, remarks, and purpose of the expense"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status of the report"
        },
        "fileUrl": {
          "type": "string",
          "maxLength": 2097152,
          "description": "Public download or storage URL for the attached receipt image/PDF"
        },
        "filePath": {
          "type": "string",
          "maxLength": 500,
          "description": "Storage path for the receipt file"
        },
        "fileName": {
          "type": "string",
          "maxLength": 255,
          "description": "Original file name of the receipt"
        },
        "fileType": {
          "type": "string",
          "maxLength": 100,
          "description": "MIME type of the receipt file (e.g., image/jpeg, image/png, application/pdf)"
        },
        "fileSize": {
          "type": "number",
          "description": "File size in bytes (max 5MB)"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the submitter"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 255,
          "description": "Email of the submitter"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "title",
        "date",
        "amount",
        "category",
        "merchant",
        "description",
        "status",
        "fileUrl",
        "filePath",
        "fileName",
        "fileType",
        "fileSize",
        "userId",
        "userEmail",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of expense receipt reports submitted by authenticated users"
    }
  }
}
